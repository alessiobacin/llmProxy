# ═══════════════════════════════════════════════════════════════════════════════
# llmProxy — .env.example
# ═══════════════════════════════════════════════════════════════════════════════
# Questo file contiene TUTTE le variabili di ambiente del progetto.
#
# ── Dove configurare cosa ────────────────────────────────────────────────────
#
#   • .env (questo file)      → variabili service-scope e env-only
#                                (richiedono restart del servizio)
#   • llmproxy config:set      → variabili project-scope
#                                (effetto immediato, senza restart)
#   • .claude/settings.json    → override di QUALSIASI variabile via campo "env"
#                                (consigliato per configurare Claude Code)
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
# development: 5045 | staging: 6045 | production: 7045
PORT=5045
HOST=127.0.0.1

# ── Environment ───────────────────────────────────────────────────────────────
# development | staging | production
NODE_ENV=development
LLMPROXY_ENV=development

# ── Runtime Profile ───────────────────────────────────────────────────────────
# development (o dev) | staging | production (o prod)
# Auto-derivato da NODE_ENV/LLMPROXY_ENV se non impostato.
# Determina i default di: NODE_ENV, LLMPROXY_ENV, LLMPROXY_MODE,
# LLMPROXY_METERING_SINK, DBLAYER_URL, EVENTBUS_URL, LLMPROXY_LOG_RETENTION_DAYS.
# LLMPROXY_RUNTIME_PROFILE=development

# ── Mode ──────────────────────────────────────────────────────────────────────
# standalone (default) | platform
# LLMPROXY_MODE=platform

# ── Logging ───────────────────────────────────────────────────────────────────
LLMPROXY_LOG_RETENTION_DAYS=7
# LLMPROXY_LOG_MAX_BYTES=5242880
# LLMPROXY_LOG_MAX_FILES=5

# ── Metering sink ─────────────────────────────────────────────────────────────
# dblayer (default in platform mode) | jsonl | inline | noop
# Combinazioni: dblayer+jsonl, dblayer+inline, ecc.
LLMPROXY_METERING_SINK=dblayer

# ── Metering inline ───────────────────────────────────────────────────────────
# Attiva il metering inline (intestazione x-inference-metric nelle risposte).
# Valori: 0 | 1 (o true | false)
# LLMPROXY_METERING_INLINE=1

# ── db-layer microservice (module 46) ─────────────────────────────────────────
# Se NON impostato → db-layer NON è attivo (nessun tentativo di POST).
# Scegli la riga per il tuo ambiente e decommentala:
#
#   DBLAYER_URL=http://localhost:5046    # development
#   DBLAYER_URL=http://localhost:6046    # staging
#   DBLAYER_URL=http://localhost:7046    # production
DBLAYER_URL=http://localhost:5046

# ── event-bus microservice (module 48) ────────────────────────────────────────
# Se NON impostato → event-bus NON è attivo (no-op, nessun tentativo di POST).
# Scegli la riga per il tuo ambiente e decommentala:
#
#   EVENTBUS_URL=http://localhost:5048   # development
#   EVENTBUS_URL=http://localhost:6048   # staging
#   EVENTBUS_URL=http://localhost:7048   # production
# EVENTBUS_URL=http://localhost:5048

# ── MongoDB sink (opzionale, solo con LLMPROXY_METERING_SINK=db) ──────────────
# LLMPROXY_MONGODB_URI=mongodb://localhost:27017
# LLMPROXY_MONGODB_DB=llmProxy
# LLMPROXY_MONGODB_METERING_COLLECTION=metering

# ── Security ──────────────────────────────────────────────────────────────────
# Secret HMAC opzionale per la firma di token interni.
# LLMPROXY_SECRET=your-secret-key

# ── Global Service ────────────────────────────────────────────────────────────
# Se 1, abilita il servizio globale sulle porte riservate 6045/7045,
# forzando la terminazione di processi in conflitto.
# LLMPROXY_GLOBAL_SERVICE=1

# ── Service Runtime ───────────────────────────────────────────────────────────
# native (LaunchAgent su macOS, systemd su Linux) | docker (Docker Compose)
# LLMPROXY_SERVICE_RUNTIME=native

# ── Docker Compose ────────────────────────────────────────────────────────────
# Queste variabili sono rilevanti solo con LLMPROXY_SERVICE_RUNTIME=docker.
# LLMPROXY_DOCKER_COMPOSE_FILE=docker-compose.yml
# LLMPROXY_DOCKER_SERVICE=llmproxy
# LLMPROXY_DOCKER_POLL_MS=2000

# ── Stats API ─────────────────────────────────────────────────────────────────
LLM_STATS_API_KEY=<your-stats-api-key>

# ── SendGrid (notifiche email) ─────────────────────────────────────────────────
SENDGRID_API_KEY=<your-api-key>
SENDGRID_FROM_EMAIL=<your-send-email>
SENDGRID_TO_EMAIL=<your-to-email>

# ── Data Directory ────────────────────────────────────────────────────────────
# Directory dati runtime. Default automatico per OS:
#   macOS:  ~/Library/Application Support/llmProxy
#   Linux:  ~/.local/share/llmProxy
# LLMPROXY_HOME=/custom/path

# ═══════════════════════════════════════════════════════════════════════════════
# Variabili Project-Scope (configurabili via CLI — effetto immediato)
# ═══════════════════════════════════════════════════════════════════════════════
#
# Queste variabili sono gestite con `llmproxy config:set/get/unset/list`
# e hanno effetto immediato (senza restart del proxy).
# Vengono salvate in .claude/settings.json → campo "env".
#
#   llmproxy config:set ANTHROPIC_BASE_URL http://127.0.0.1:7045
#   llmproxy config:set LLMPROXY_SMART_ROUTE hybrid
#   llmproxy config:set LLMPROXY_SMART_PREFERENCE balanced
#   llmproxy config:list
#
# Possono comunque essere sovrascritte anche qui nel .env o nel campo "env"
# di .claude/settings.json.

# ── Anthropic Endpoint ────────────────────────────────────────────────────────
# URL base dell'endpoint Anthropic-compatibile (il proxy stesso).
# ANTHROPIC_BASE_URL=http://127.0.0.1:7045

# ── Anthropic Default Model ───────────────────────────────────────────────────
# Modello predefinito per le richieste Anthropic.
# Supporta catene di fallback: "copilot:claude-sonnet-4-6,openai:gpt-5"
# ANTHROPIC_DEFAULT_MODEL=copilot:claude-sonnet-4-6

# ── Anthropic Auth Token ──────────────────────────────────────────────────────
# Token di autenticazione per l'endpoint Anthropic.
# ANTHROPIC_AUTH_TOKEN=sk-your-token

# ── API Timeout ───────────────────────────────────────────────────────────────
# Timeout in millisecondi per le richieste API.
# API_TIMEOUT_MS=3000000

# ── Claude Code Experimental Betas ────────────────────────────────────────────
# Se 1, disabilita le beta sperimentali di Claude Code.
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# ── Short Answer ──────────────────────────────────────────────────────────────
# Se 1, attiva la modalità risposta breve.
# LLMPROXY_SHORT_ANSWER=1

# ── Smart Router ───────────────────────────────────────────────────────────────
# Strategia di routing in base alla complessità della richiesta.
# Valori: hybrid | economy | standard | premium
# LLMPROXY_SMART_ROUTE=hybrid

# ── Smart Preference ──────────────────────────────────────────────────────────
# Preferenza per bilanciamento costo/qualità.
# Valori: balanced | economy | quality
# LLMPROXY_SMART_PREFERENCE=balanced

# ── Smart Cache TTL ───────────────────────────────────────────────────────────
# TTL in secondi per la cache dello smart router.
# LLMPROXY_SMART_CACHE_TTL=300
