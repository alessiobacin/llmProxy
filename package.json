{
  "name": "llmproxy",
  "version": "0.3.64",
  "description": "Standalone GitHub Copilot proxy CLI with native service management",
  "main": "server.js",
  "bin": {
    "llmproxy": "bin/llmproxy.js",
    "llmp": "bin/llmproxy.js"
  },
  "files": [
    "api/",
    "assets/",
    "bin/",
    "scripts/install.sh",
    "lib/",
    "Dockerfile",
    "docker-compose.production.yml",
    "server.js",
    "manifest.json",
    "release-notes.json"
  ],
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "install:persistent": "node bin/llmproxy.js install:persistent-it",
    "install:persistent-it": "node bin/llmproxy.js install:persistent-it",
    "install:persistent-en": "node bin/llmproxy.js install:persistent-en",
    "build:ts": "tsc -p tsconfig.json",
    "test": "npm run build:ts && node --test tests/*.test.js",
    "update:service": "./scripts/update-service.sh"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "express": "^4.21.0",
    "mongodb": "^7.2.0",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
