{
  "name": "llmproxy",
  "version": "0.2.60",
  "description": "Standalone GitHub Copilot proxy CLI with native service management",
  "main": "server.js",
  "bin": {
    "llmproxy": "bin/llmproxy.js"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "install:persistent": "node bin/llmproxy.js install:persistent-it",
    "install:persistent-it": "node bin/llmproxy.js install:persistent-it",
    "install:persistent-en": "node bin/llmproxy.js install:persistent-en",
    "build:ts": "tsc -p tsconfig.json",
    "test": "npm run build:ts && node --test tests/*.test.js"
  },
  "llmproxyReleaseNotes": {
    "0.2.60": [
      "release 0.2.60",
      "embed current release notes in the installed package for first-update compatibility",
      "keep deriving update changelogs from the release commit message when available",
      "preserve hardcoded release notes only as a backward-compatible final fallback"
    ]
  },
  "dependencies": {
    "express": "^4.21.0",
    "mongodb": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}