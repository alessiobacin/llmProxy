    {
      "name": "03 - LLM Compatibility (Standalone-friendly)",
      "item": [
        {
          "name": "GET /v1/models",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/models"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200 without auth', function () {", "  pm.response.to.have.status(200);", "});", "pm.test('Body is an OpenAI model list', function () {", "  const body = pm.response.json();", "  pm.expect(body.object).to.eql('list');", "  pm.expect(body).to.have.property('data');", "});"] } }]
        },
        {
          "name": "POST /v1/messages",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Trace-Id", "value": "{{traceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{llmProxyModel}}\",\n  \"max_tokens\": 64,\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Ciao da Postman\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/v1/messages"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200 or 401', function () {", "  pm.expect([200, 401]).to.include(pm.response.code);", "});", "if (pm.response.code === 200) {", "  const body = pm.response.json();", "  const textBlocks = Array.isArray(body.content) ? body.content.filter(function (block) { return block.type === 'text'; }) : [];", "  const lastText = textBlocks.length ? String(textBlocks[textBlocks.length - 1].text || '') : '';", "  pm.test('Inference footer includes provider and model', function () {", "    pm.expect(lastText).to.include('[llmproxy] provider:');", "    pm.expect(lastText).to.include('| model:');", "  });", "}"] } }]
        },
        {
          "name": "POST /v1/chat/completions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Trace-Id", "value": "{{traceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{llmProxyModel}}\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Hello from Postman\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/v1/chat/completions"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200 or 401', function () {", "  pm.expect([200, 401]).to.include(pm.response.code);", "});"] } }]
        },
        {
          "name": "POST /v1/responses",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Trace-Id", "value": "{{traceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{llmProxyModel}}\",\n  \"instructions\": \"Rispondi in modo conciso.\",\n  \"max_output_tokens\": 64,\n  \"input\": [\n    { \"role\": \"user\", \"content\": [ { \"type\": \"input_text\", \"text\": \"Hello from Postman (Responses API)\" } ] }\n  ]\n}"
            },
            "url": "{{baseUrl}}/v1/responses"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200 or 401', function () {", "  pm.expect([200, 401]).to.include(pm.response.code);", "});", "if (pm.response.code === 200) {", "  const body = pm.response.json();", "  pm.test('Responses shape', function () {", "    pm.expect(body.object).to.eql('response');", "    pm.expect(body.status).to.eql('completed');", "    pm.expect(body.output[0].type).to.eql('message');", "  });", "}"] } }]
        }
      ]
    },
